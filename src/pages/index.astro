---
import Layout from "../layouts/Layout.astro";

const event = {
  countryFlag: "🇵🇾",
  title: "Copa América PMU – Paraguay",
  subtitle: "Semifinal Oficial rumbo a Medellín 2026",
  venue: "Hotel Guaraní – Asunción, Paraguay",
  dates: "1 y 2 de Agosto de 2026",
  intro:
    "Paraguay es sede oficial de la Copa América PMU, el primer campeonato intercontinental de micropigmentación creado para la comunidad latina. Dos días donde el talento, la técnica y la identidad de nuestra región se encuentran en un escenario de alto nivel.",
};

const categories = [
  "Brows – Microblading",
  "Brows – Hairstroke",
  "Lips – Full Lips",
  "Shadow – Efecto Polvo",
];

const pricing = {
  presale: {
    price: "USD 600",
    includes: [
      "Acceso a los dos días (Campeonato + Congreso)",
      "1 categoría de competencia de regalo (a elección)",
    ],
    extraCategory: "USD 200 por categoría adicional",
    extraCategory2: "USD 200",
  },

  masterclass: {
    title: "MASTER JUAN CORDERO",
    dates: "25 y 26 de julio",
    tiers: [
      {
        label: "Preventa 1",
        list: "USD 1000",
        cash: "USD 900",
        deposit: "USD 100",
        status: "closed",
      },
      {
        label: "Preventa 2",
        list: "USD 1100",
        cash: "USD 1000",
        deposit: "USD 150",
        status: "active",
      },
      {
        label: "Venta General",
        list: "USD 1300",
        cash: "USD 1200",
        deposit: "USD 200",
        status: "next",
      },
    ],
    note: "Cupos limitados. Reservá tu lugar con la seña y asegurá el precio de preventa.",
  },

  demoNacional: {
    price: "USD 400",
    note: "Este valor es independiente de la entrada al evento.",
    bullets: [
      "Posicionar tu marca",
      "Mostrar tu técnica",
      "Ganar visibilidad internacional",
    ],
  },
};

const starSpeaker = {
  name: "Juan Cordero",
  topic: "Hairstrokes",
  text: "Juan Cordero, uno de los referentes más importantes de Hairstrokes en Latinoamérica, llega a Paraguay como speaker principal de la Copa América PMU.",
  masterclassText:
    "Masterclass exclusiva de Hairstrokes: formación intensiva para artistas que buscan perfeccionar técnica, criterio y resultados de nivel internacional.",
  imgSrc: "/curso.jpeg",
  imgAlt: "Speaker - Juan Cordero",
};

const organizer = {
  name: "Liz Sánchez",
  role: "Organizer",
  imgAlt: "Organizer - Liz Sánchez",
  bio: [
    "Liz Sánchez es artista de retratos y especialista en cejas y micropigmentación, con más de 15 años de trayectoria impulsando una mirada profesional, consciente y con criterio dentro de la industria.",
    "Es fundadora de Bar de Cejas, el primer estudio exclusivo de cejas en Argentina, y creadora de La Jefa, un concepto que promueve liderazgo, identidad y toma de decisiones con fundamento.",
    "Su enfoque integra arte, técnica y lectura facial, desarrollando una metodología propia basada en el realismo, el respeto por la fisonomía y las particularidades de las pieles latinas.",
    "Ha sido jueza en campeonatos internacionales y speaker en escenarios de alto nivel, además de organizadora de congresos y competencias, espacios creados para elevar estándares, profesionalizar el rubro y generar crecimiento real en la industria.",
  ],
  imgSrc: "/liz.jpeg",
};

const teamLeader = {
  name: "Sara Ramírez",
  role: "Team Leader",
  imgAlt: "Team Leader - Sara Ramírez",
  bio: [
    "Sara Ramírez es ingeniera en marketing y publicidad, empresaria, dermopigmentadora habilitada por el Ministerio de Educación, educadora y disertante.",
    "Fundadora de Sra. Belleza, cuenta con más de siete años de experiencia en micropigmentación.",
    "Es creadora de congresos nacionales y colaboradora en congresos internacionales, trabajando activamente para elevar el nivel de formación y conocimiento del rubro en Paraguay, integrando técnica, estrategia y visión.",
  ],
  imgSrc: "/sara.jpeg",
};

const finals = {
  title: "Gran Final Copa América PMU",
  location: "Medellín – Colombia",
  dates: "26 de agosto 2026",
  text: "Las artistas ganadoras de Paraguay clasifican a la Gran Final Intercontinental en Medellín, dentro del Congreso CIM, donde se reúnen los campeones de toda Latinoamérica para definir al Champion of Champions.",
};

const nav = [
  { id: "wulop", label: "Copa" },
  { id: "evento", label: "Evento" },
  { id: "dias", label: "Días" },
  { id: "equipo", label: "Equipo" },
  { id: "speaker", label: "Speaker" },
  { id: "categorias", label: "Categorías" },
  { id: "entradas", label: "Entradas" },
  { id: "clasificacion", label: "Clasificación" },
  { id: "contacto", label: "Contacto" },
];
---

<Layout>
  <html lang="es">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width,initial-scale=1" />
      <title>{event.title} | {event.dates}</title>
      <meta
        name="description"
        content="Semifinal oficial rumbo a Medellín 2026. Campeonato + Congreso Internacional de micropigmentación en Asunción, Paraguay."
      />
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </head>

    <body>
      <style>
        :global(:root) {
          --ink: #1c1b22;
          --ink-2: #2a2933;
          --cream: #fbf6ea;
          --paper: rgba(255, 255, 255, 0.72);
          --lav: #6b5cff;
          --teal: #0ea5a4;
          --rose: #ff4fa3;
          --gold: #d1a954;
        }
        :global(html) {
          scroll-behavior: smooth;
        }
        :global(body) {
          font-family:
            Inter,
            system-ui,
            -apple-system,
            Segoe UI,
            Roboto,
            Arial,
            sans-serif;
          color: var(--ink);
          background:
            radial-gradient(
              1200px 600px at 20% 10%,
              rgba(107, 92, 255, 0.18),
              transparent 60%
            ),
            radial-gradient(
              900px 500px at 90% 20%,
              rgba(14, 165, 164, 0.16),
              transparent 55%
            ),
            radial-gradient(
              1100px 700px at 60% 90%,
              rgba(255, 79, 163, 0.12),
              transparent 60%
            ),
            linear-gradient(180deg, var(--cream), #fff);
        }
        .title-font {
          font-family: Cinzel, serif;
          letter-spacing: 0.02em;
        }
        .card {
          background: rgba(255, 255, 255, 0.78);
          border: 1px solid rgba(28, 27, 34, 0.1);
          box-shadow: 0 18px 50px rgba(28, 27, 34, 0.1);
          backdrop-filter: blur(10px);
        }
        .stroke {
          border: 1px solid rgba(28, 27, 34, 0.12);
        }
        .divider {
          height: 1px;
          background: linear-gradient(
            90deg,
            transparent,
            rgba(28, 27, 34, 0.18),
            transparent
          );
        }
        .pattern-cards {
          background-image:
            radial-gradient(
              circle at 10px 10px,
              rgba(28, 27, 34, 0.06) 2px,
              transparent 2px
            ),
            radial-gradient(
              circle at 30px 30px,
              rgba(107, 92, 255, 0.08) 2px,
              transparent 2px
            ),
            radial-gradient(
              circle at 20px 40px,
              rgba(14, 165, 164, 0.08) 2px,
              transparent 2px
            );
          background-size: 48px 48px;
          mask-image: radial-gradient(
            ellipse at center,
            black 55%,
            transparent 75%
          );
        }
        .chip {
          border: 1px solid rgba(28, 27, 34, 0.14);
          background: rgba(255, 255, 255, 0.65);
        }
        .btn-primary {
          background: linear-gradient(135deg, var(--lav), var(--rose));
          color: #fff;
        }
        .btn-primary:hover {
          filter: brightness(0.98);
        }
        .btn-soft {
          background: rgba(255, 255, 255, 0.7);
          border: 1px solid rgba(28, 27, 34, 0.14);
        }
        .btn-soft:hover {
          background: rgba(255, 255, 255, 0.85);
        }
        .ribbon {
          background: linear-gradient(
            90deg,
            rgba(14, 165, 164, 0.12),
            rgba(107, 92, 255, 0.12),
            rgba(255, 79, 163, 0.1)
          );
          border: 1px solid rgba(28, 27, 34, 0.1);
        }
        .avatar {
          width: 100%;
          aspect-ratio: 4 / 5;
          border-radius: 24px;
          border: 1px solid rgba(28, 27, 34, 0.12);
          background: linear-gradient(
            135deg,
            rgba(107, 92, 255, 0.1),
            rgba(255, 79, 163, 0.08)
          );
          display: grid;
          place-items: center;
          overflow: hidden;
          position: relative;
        }
        .avatar img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }
        .avatar .ph {
          font-size: 12px;
          color: rgba(28, 27, 34, 0.65);
          font-weight: 600;
          letter-spacing: 0.02em;
          padding: 10px 12px;
          border-radius: 999px;
          border: 1px dashed rgba(28, 27, 34, 0.25);
          background: rgba(255, 255, 255, 0.55);
        }
        .avatar:has(img) {
          background: #fff;
        }
        .avatar:has(img) .ph {
          display: none;
        }
      </style>

      <header
        class="sticky top-0 z-50 border-b border-black/10 bg-white/70 backdrop-blur"
      >
        <div
          class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3"
        >
          <a href="#top" class="flex items-center gap-2">
            <span class="text-lg">{event.countryFlag}</span>
            <span class="title-font text-sm font-semibold">
              COPA AMÉRICA PMU · PARAGUAY
            </span>
          </a>

          <nav class="hidden gap-5 md:flex">
            {
              nav.map((n) => (
                <a
                  href={`#${n.id}`}
                  class="text-xs font-semibold text-black/70 hover:text-black transition"
                >
                  {n.label}
                </a>
              ))
            }
          </nav>

          <a
            href="#entradas"
            class="rounded-full px-4 py-2 text-xs font-semibold btn-soft"
          >
            Ver entradas
          </a>
        </div>
      </header>

      <main id="top">
        <section class="relative mx-auto max-w-6xl px-4 pt-14 pb-10">
          <div class="pointer-events-none absolute inset-0 -z-10 pattern-cards">
          </div>

          <div class="grid gap-8 md:grid-cols-2 md:items-center">
            <div>
              <div
                class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs ribbon"
              >
                <span class="font-semibold">Semifinal Oficial</span>
                <span class="opacity-40">•</span>
                <span>Rumbo a Medellín 2026</span>
              </div>

              <h1
                class="mt-5 title-font text-4xl font-semibold tracking-tight md:text-5xl text-[color:var(--ink)]"
              >
                {event.title}
              </h1>

              <p class="mt-3 text-lg text-black/70">{event.subtitle}</p>

              <div class="mt-6 grid gap-3 text-sm text-black/70">
                <div class="flex items-center gap-2">
                  <span class="chip rounded-md px-2 py-1 text-xs">📍</span>
                  <span>{event.venue}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="chip rounded-md px-2 py-1 text-xs">📅</span>
                  <span>{event.dates}</span>
                </div>
              </div>

              <p class="mt-6 max-w-xl text-sm leading-relaxed text-black/70">
                {event.intro}
              </p>

              <div class="mt-8 flex flex-wrap gap-3">
                <a
                  href="#entradas"
                  class="rounded-full px-6 py-3 text-sm font-semibold btn-primary"
                >
                  Quiero participar
                </a>
                <a
                  href="#dias"
                  class="rounded-full px-6 py-3 text-sm font-semibold btn-soft"
                >
                  Ver estructura del evento
                </a>
              </div>

              <div class="mt-6 flex flex-wrap gap-2 text-xs text-black/60">
                <span class="chip rounded-full px-3 py-2">🕰️ Precisión</span>
                <span class="chip rounded-full px-3 py-2">🎴 Técnica</span>
                <span class="chip rounded-full px-3 py-2"
                  >🚪 Acceso internacional</span
                >
                <span class="chip rounded-full px-3 py-2"
                  >🌿 Comunidad latina</span
                >
              </div>
            </div>

            <div class="relative">
              <div class="card rounded-3xl p-7">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-xs font-semibold text-black/60">Temática</p>
                    <h2
                      class="mt-1 title-font text-2xl font-semibold text-[color:var(--ink)]"
                    >
                      Alicia en el País de las Maravillas
                    </h2>
                  </div>

                  <div
                    class="shrink-0 rounded-2xl stroke bg-white/60 px-3 py-2"
                  >
                    <svg
                      width="34"
                      height="34"
                      viewBox="0 0 24 24"
                      fill="none"
                      class="opacity-90"
                    >
                      <path
                        d="M6 20V6.5L14.5 4v16L6 20Z"
                        stroke="currentColor"
                        stroke-width="1.5"></path>
                      <path
                        d="M14.5 4H18v16h-3.5"
                        stroke="currentColor"
                        stroke-width="1.5"></path>
                      <circle cx="12.7" cy="12" r="0.7" fill="currentColor"
                      ></circle>
                    </svg>
                  </div>
                </div>

                <div class="mt-6 grid gap-3 md:grid-cols-2">
                  <div class="rounded-2xl stroke bg-white/60 p-4">
                    <p class="text-xs font-semibold text-black/60">Formato</p>
                    <p
                      class="mt-1 text-sm font-semibold text-[color:var(--ink)]"
                    >
                      Campeonato + Congreso
                    </p>
                    <p class="mt-2 text-xs text-black/70">
                      Competencia en modelo real + formación, demos y
                      premiación.
                    </p>
                  </div>

                  <div class="rounded-2xl stroke bg-white/60 p-4">
                    <p class="text-xs font-semibold text-black/60">Destino</p>
                    <p
                      class="mt-1 text-sm font-semibold text-[color:var(--ink)]"
                    >
                      Clasifica a Medellín
                    </p>
                    <p class="mt-2 text-xs text-black/70">
                      Ganadoras Paraguay → Gran Final Intercontinental (Congreso
                      CIM).
                    </p>
                  </div>
                </div>

                <div class="mt-6 divider"></div>

                <div class="mt-5 flex flex-wrap gap-2 text-xs text-black/65">
                  <span class="chip rounded-full px-3 py-2"
                    >🎓 Formación avanzada</span
                  >
                  <span class="chip rounded-full px-3 py-2"
                    >🏆 Evaluación internacional</span
                  >
                  <span class="chip rounded-full px-3 py-2">🤝 Networking</span>
                </div>
              </div>

              <div
                class="pointer-events-none absolute -bottom-10 -right-10 h-44 w-44 rounded-full bg-[color:var(--rose)]/15 blur-3xl"
              >
              </div>
            </div>
          </div>
        </section>

        <section id="wulop" class="mx-auto max-w-6xl px-4 py-12">
          <div class="card rounded-3xl p-8">
            <p
              class="text-xs font-semibold tracking-wide text-[color:var(--lav)]"
            >
              Copa América PMU
            </p>
            <h2
              class="mt-2 title-font text-3xl font-semibold text-[color:var(--ink)]"
            >
              El campeonato intercontinental para la comunidad latina
            </h2>
            <p class="mt-4 max-w-3xl text-sm leading-relaxed text-black/70">
              Dos días donde el talento, la técnica y la identidad regional se
              encuentran en un escenario profesional. Evaluación con jueces bajo
              estándares internacionales adaptados a nuestra estética y rasgos.
            </p>
          </div>
        </section>

        <section id="evento" class="mx-auto max-w-6xl px-4 py-12">
          <div class="grid gap-6 md:grid-cols-3">
            <div class="card rounded-3xl p-7 md:col-span-2">
              <h2
                class="title-font text-3xl font-semibold text-[color:var(--ink)]"
              >
                Datos del evento
              </h2>

              <div class="mt-5 grid gap-3 text-sm text-black/70">
                <div class="flex items-center gap-2">
                  <span class="chip rounded-md px-2 py-1 text-xs">📍</span>
                  <span>{event.venue}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="chip rounded-md px-2 py-1 text-xs">📅</span>
                  <span>{event.dates}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="chip rounded-md px-2 py-1 text-xs">🏁</span>
                  <span>Semifinal oficial rumbo a Medellín 2026</span>
                </div>
              </div>

              <div class="mt-6 rounded-2xl stroke bg-white/60 p-5">
                <p class="text-sm text-black/70">
                  <span class="font-semibold text-[color:var(--ink)]"
                    >Dos días</span
                  >
                  de competencia y formación con alto estándar.
                </p>
              </div>
            </div>

            <div class="card rounded-3xl p-7">
              <p
                class="text-xs font-semibold tracking-wide text-[color:var(--teal)]"
              >
                Atajos
              </p>

              <div class="mt-4 grid gap-3 text-sm">
                <a
                  class="rounded-2xl stroke bg-white/60 px-4 py-3 hover:bg-white/80 transition"
                  href="#dias"
                >
                  → Estructura del evento
                </a>
                <a
                  class="rounded-2xl stroke bg-white/60 px-4 py-3 hover:bg-white/80 transition"
                  href="#equipo"
                >
                  → Equipo
                </a>
                <a
                  class="rounded-2xl stroke bg-white/60 px-4 py-3 hover:bg-white/80 transition"
                  href="#entradas"
                >
                  → Entradas & precios
                </a>
                <a
                  class="rounded-2xl stroke bg-white/60 px-4 py-3 hover:bg-white/80 transition"
                  href="#clasificacion"
                >
                  → Clasificación
                </a>
              </div>
            </div>
          </div>
        </section>

        <section id="dias" class="mx-auto max-w-6xl px-4 py-12">
          <h2 class="title-font text-3xl font-semibold text-[color:var(--ink)]">
            🗓️ Estructura del Evento
          </h2>

          <div class="mt-6 grid gap-6 md:grid-cols-2">
            <div class="card rounded-3xl p-7">
              <p
                class="text-xs font-semibold tracking-wide text-[color:var(--rose)]"
              >
                Día 1
              </p>
              <h3
                class="mt-2 title-font text-xl font-semibold text-[color:var(--ink)]"
              >
                🏆 Campeonato Oficial
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-black/70">
                Competencia en <span
                  class="font-semibold text-[color:var(--ink)]"
                  >modelo real</span
                >
                dentro de las categorías oficiales. Evaluación por jueces profesionales
                con criterios internacionales diseñados para estética latina.
              </p>
            </div>

            <div class="card rounded-3xl p-7">
              <p
                class="text-xs font-semibold tracking-wide text-[color:var(--teal)]"
              >
                Día 2
              </p>
              <h3
                class="mt-2 title-font text-xl font-semibold text-[color:var(--ink)]"
              >
                🎤 Congreso + Premiación
              </h3>
              <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-black/70">
                <li>Formación avanzada</li>
                <li>Inspiración</li>
                <li>Demos en vivo</li>
                <li>Speakers internacionales</li>
                <li>Networking</li>
              </ul>
              <p class="mt-4 text-sm leading-relaxed text-black/70">
                Ceremonia oficial de premiación + anuncio de clasificadas a la
                Gran Final Intercontinental.
              </p>
            </div>
          </div>
        </section>

        <section id="equipo" class="mx-auto max-w-6xl px-4 py-12">
          <div class="card rounded-3xl p-8">
            <p
              class="text-xs font-semibold tracking-wide text-[color:var(--teal)]"
            >
              ♟️ Equipo
            </p>

            <h2
              class="mt-2 title-font text-3xl font-semibold text-[color:var(--ink)]"
            >
              Organización & liderazgo
            </h2>

            <p class="mt-4 max-w-3xl text-sm leading-relaxed text-black/70">
              Personas que sostienen la estructura del evento y elevan el
              estándar: criterio, visión y ejecución.
            </p>

            <div class="mt-8 grid gap-8 lg:grid-cols-2">
              <article class="rounded-3xl stroke bg-white/60 p-6">
                <div class="grid gap-6 md:grid-cols-[180px_1fr]">
                  <div class="avatar">
                    <img
                      src={organizer.imgSrc}
                      alt={organizer.imgAlt}
                      loading="lazy"
                    />
                    <span class="ph">Espacio para imagen</span>
                  </div>

                  <div>
                    <div
                      class="inline-flex items-center gap-2 rounded-full px-3 py-2 text-xs chip"
                    >
                      <span class="font-semibold text-[color:var(--ink)]"
                        >{organizer.role}</span
                      >
                      <span class="opacity-40">•</span>
                      <span class="text-black/70">{organizer.name}</span>
                    </div>

                    <div
                      class="mt-4 space-y-3 text-sm text-black/70 leading-relaxed"
                    >
                      {organizer.bio.map((p) => <p>{p}</p>)}
                    </div>
                  </div>
                </div>
              </article>

              <article class="rounded-3xl stroke bg-white/60 p-6">
                <div class="grid gap-6 md:grid-cols-[180px_1fr]">
                  <div class="avatar">
                    <img
                      src={teamLeader.imgSrc}
                      alt={teamLeader.imgAlt}
                      loading="lazy"
                    />
                    <span class="ph">Espacio para imagen</span>
                  </div>

                  <div>
                    <div
                      class="inline-flex items-center gap-2 rounded-full px-3 py-2 text-xs chip"
                    >
                      <span class="font-semibold text-[color:var(--ink)]"
                        >{teamLeader.role}</span
                      >
                      <span class="opacity-40">•</span>
                      <span class="text-black/70">{teamLeader.name}</span>
                    </div>

                    <div
                      class="mt-4 space-y-3 text-sm text-black/70 leading-relaxed"
                    >
                      {teamLeader.bio.map((p) => <p>{p}</p>)}
                    </div>
                  </div>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section id="speaker" class="mx-auto max-w-6xl px-4 py-12">
          <div class="card rounded-3xl p-8">
            <p
